<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Automotive-only app. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <!-- Features AAOS cars may lack; declared not-required so Play for Cars doesn't filter us out. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".OrchardDriveApp"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:replace="android:allowBackup">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- Small icon AAOS uses for this media source. -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_app_attribution" />

        <service
            android:name=".automotive.AutomotiveMusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- AAOS Media Center discovers sources through the legacy browser action. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Proxies Apple artwork to Media Center as content:// URIs (see ArtworkProvider). -->
        <provider
            android:name=".automotive.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
            Parked-only settings screen (account, display, about). AAOS media apps don't get a regular launcher
            entry; Media Center opens this via APPLICATION_PREFERENCES (gear icon) and the session
            activity. Launch manually with:
            adb shell am start -n com.dverba.aaosmusic/com.aaosmusic.ui.MainActivity
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Diagnostics (status, debug report); unlocked by tapping Settings → Version 7 times. -->
        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostics" />

        <!-- Debug-only MusicKit compatibility test screen (docs/MUSICKIT_AAOS_COMPATIBILITY.md). -->
        <activity
            android:name=".ui.AppleMusicTestActivity"
            android:exported="true"
            android:label="Apple Music Test"
            android:launchMode="singleTop" />

        <!--
            MusicKit auth SDK (2021) predates Android 12's explicit-export rule. Its redirect handler
            receives the musicsdk:// callback from the Apple Music app, so it must be exported.
            Harmless when the SDK isn't bundled (the class simply doesn't exist).
        -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            android:exported="true"
            tools:ignore="MissingClass"
            tools:node="merge" />
    </application>
</manifest>
